# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ephorsys?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nodemailer / SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Ephorsys Security" <no-reply@ephorsys.com>
SMTP_FROM_NAME="Ephorsys Security"

